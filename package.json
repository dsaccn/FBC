{
  "name": "kogna-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "vercel-build": "npx prisma generate --schema=prisma/schema.postgres.prisma && npx prisma db push --schema=prisma/schema.postgres.prisma --accept-data-loss && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:seed:menu": "npx tsx scripts/seed_kogna_menu.ts",
    "db:studio": "npx prisma studio",
    "clear:all": "npx tsx scripts/clear_all.ts",
    "clear:orders": "node scripts/clear_orders_keep_menu_inventory.js",
    "clear:offline": "npx tsx scripts/clear_offline.ts",
    "clear:cloud": "npx tsx scripts/clear_cloud.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "jose": "^5.9.6",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.511.0",
    "next": "16.2.6",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
