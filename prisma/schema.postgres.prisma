generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  fullName     String
  role         String    @default("WAITER") // ADMIN, MANAGER, CASHIER, WAITER
  phone        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  orders        Order[]
  payments      Payment[]
  cancellations Cancellation[]
  shiftLogs     ShiftLog[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  type      String     // FOOD, DRINK
  createdAt DateTime   @default(now())

  menuItems MenuItem[]
}

model MenuItem {
  id                String   @id @default(cuid())
  categoryId        String?
  name              String
  description       String?
  price             Float
  available         Boolean  @default(true)
  stockQuantity     Int      @default(0)
  barQuantity       Int      @default(0)
  costPrice         Float    @default(0)
  lowStockThreshold Int      @default(5)
  parentItemId      String?
  unitMultiplier    Float    @default(1)
  createdAt         DateTime @default(now())

  category       Category?       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  recipes        Recipe[]
  parentItem     MenuItem?       @relation("UnitLink", fields: [parentItemId], references: [id], onDelete: SetNull)
  childItems     MenuItem[]      @relation("UnitLink")
  staffMenuItems StaffMenuItem[]
}

model Table {
  id              String   @id @default(cuid())
  number          String   @unique
  status          String   @default("FREE")
  mergedWithId    String?
  mergeGroupId    String?
  mergeGroupLabel String?
  createdAt       DateTime @default(now())
  pendingSync     Boolean  @default(false)

  orders Order[]
}

model Order {
  id          String    @id @default(cuid())
  tableId     String
  waiterId    String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pendingSync Boolean   @default(false) // On cloud, default false (already on cloud)
  syncedAt    DateTime?

  // Phone QR Payment Verification fields
  verifiedRef      String?
  verifiedProvider String?
  verifiedAmount   Float?
  verifiedPayer    String?
  verifiedReceiver String?
  verifiedAt       DateTime?

  table      Table       @relation(fields: [tableId], references: [id])
  waiter     User        @relation(fields: [waiterId], references: [id])
  orderItems OrderItem[]
  payment    Payment?

  @@index([status])
  @@index([tableId])
  @@index([pendingSync])
  @@index([createdAt])
  @@index([tableId, status])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  menuItemId  String
  quantity    Int
  notes       String?
  status      String    @default("PENDING")
  printedAt   DateTime?
  createdAt   DateTime  @default(now())
  pendingSync Boolean   @default(false)

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem       @relation(fields: [menuItemId], references: [id])
  cancellation Cancellation?

  @@index([orderId])
  @@index([pendingSync])
  @@index([menuItemId])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  cashierId       String
  amount          Float
  method          String
  discount        Float    @default(0)
  discountType    String   @default("fixed")
  isComplimentary Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  pendingSync     Boolean  @default(false)

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashier User  @relation(fields: [cashierId], references: [id])

  @@index([pendingSync])
  @@index([createdAt])
}

model Cancellation {
  id          String   @id @default(cuid())
  orderItemId String   @unique
  managerId   String
  reason      String
  createdAt   DateTime @default(now())
  pendingSync Boolean  @default(false)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  manager   User      @relation(fields: [managerId], references: [id])
}

model ShiftLog {
  id        String    @id @default(cuid())
  userId    String
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Ingredient {
  id           String   @id @default(cuid())
  name         String
  unit         String
  quantity     Float    @default(0)
  costPerUnit  Float    @default(0) // Bought / cost price per unit
  minThreshold Float    @default(0)
  createdAt    DateTime @default(now())

  recipes      Recipe[]
}

model Recipe {
  id           String     @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Float

  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
}

model InventoryLog {
  id          String   @id @default(cuid())
  itemName    String
  type        String   // STORE, BAR, INGREDIENT
  action      String   // ADD, TRANSFER, INITIAL, SET
  quantity    Float
  prevQty     Float
  newQty      Float
  userName    String
  createdAt   DateTime @default(now())
  pendingSync Boolean  @default(false)
}

model StaffMember {
  id          String      @id @default(cuid())
  name        String
  role        String
  shift       String      @default("Morning")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  pendingSync Boolean     @default(false)

  meals     StaffMeal[]
}

model StaffMenuItem {
  id               String          @id @default(cuid())
  name             String
  mealType         String
  linkedMenuItemId String?
  createdAt        DateTime        @default(now())
  pendingSync      Boolean         @default(false)

  linkedMenuItem   MenuItem?       @relation(fields: [linkedMenuItemId], references: [id], onDelete: SetNull)
  mealItems        StaffMealItem[]
  recipes          StaffRecipe[]
}

model StaffIngredient {
  id           String        @id @default(cuid())
  name         String
  unit         String
  quantity     Float         @default(0)
  minThreshold Float         @default(0)
  createdAt    DateTime      @default(now())
  pendingSync  Boolean       @default(false)

  recipes      StaffRecipe[]
}

model StaffRecipe {
  id                String          @id @default(cuid())
  staffMenuItemId   String
  staffIngredientId String
  quantity          Float
  pendingSync       Boolean         @default(false)

  staffMenuItem     StaffMenuItem   @relation(fields: [staffMenuItemId], references: [id], onDelete: Cascade)
  staffIngredient   StaffIngredient @relation(fields: [staffIngredientId], references: [id], onDelete: Cascade)

  @@unique([staffMenuItemId, staffIngredientId])
}

model StaffMeal {
  id            String          @id @default(cuid())
  staffMemberId String
  mealType      String
  servedAt      DateTime        @default(now())
  createdAt     DateTime        @default(now())
  pendingSync   Boolean         @default(false)

  staffMember   StaffMember     @relation(fields: [staffMemberId], references: [id])
  items         StaffMealItem[]
}

model StaffMealItem {
  id              String        @id @default(cuid())
  staffMealId     String
  staffMenuItemId String
  quantity        Int           @default(1)
  pendingSync     Boolean       @default(false)

  staffMeal       StaffMeal     @relation(fields: [staffMealId], references: [id], onDelete: Cascade)
  staffMenuItem   StaffMenuItem @relation(fields: [staffMenuItemId], references: [id])
}

model DevAuditLog {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  developerUsername String
  action            String   // CREATE, UPDATE, DELETE, SQL_QUERY, SEED, RESET, SYNC
  targetTable       String
  recordId          String?
  previousState     String?  // JSON string
  newState          String?  // JSON string
  reason            String?
  ipAddress         String?

  @@index([targetTable])
  @@index([timestamp])
  @@index([action])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?
  portal    String   @default("POS")
  createdAt DateTime @default(now())

  @@index([username])
  @@index([createdAt])
  @@index([success])
}

model LoginHistory {
  id        String    @id @default(cuid())
  userId    String?
  username  String
  fullName  String?
  role      String?
  ipAddress String?
  userAgent String?
  portal    String    @default("POS")
  status    String    @default("ACTIVE")
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([username])
  @@index([userId])
  @@index([loginAt])
  @@index([status])
}

model WasteLog {
  id          String   @id @default(cuid())
  itemName    String
  itemType    String
  itemId      String?
  location    String?
  quantity    Float
  unit        String?
  costPerUnit Float    @default(0)
  totalCost   Float    @default(0)
  reason      String
  notes       String?
  loggedBy    String
  createdAt   DateTime @default(now())
  pendingSync Boolean  @default(false)

  @@index([itemName])
  @@index([itemType])
  @@index([createdAt])
  @@index([pendingSync])
}

model AbebeCredential {
  id           String   @id @default("master_root")
  username     String   @default("ROOT")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}



