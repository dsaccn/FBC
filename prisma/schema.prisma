generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  fullName     String
  role         String    @default("WAITER") // ADMIN, MANAGER, CASHIER, WAITER
  phone        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  orders        Order[]
  payments      Payment[]
  cancellations Cancellation[]
  shiftLogs     ShiftLog[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  type      String     // FOOD, DRINK
  createdAt DateTime   @default(now())

  menuItems MenuItem[]
}

model MenuItem {
  id                String   @id @default(cuid())
  categoryId        String?
  name              String
  description       String?
  price             Float
  available         Boolean  @default(true)
  stockQuantity     Int      @default(0) // Used as Store Quantity
  barQuantity       Int      @default(0) // Used as Bar Quantity
  costPrice         Float    @default(0) // Bought/cost price per unit
  lowStockThreshold Int      @default(5)
  parentItemId      String?              // If set, this item is a unit of a parent (e.g. Jambo -> Single)
  unitMultiplier    Float    @default(1) // How many parent units this item equals (e.g. 1.5)
  createdAt         DateTime @default(now())

  category       Category?       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  recipes        Recipe[]
  parentItem     MenuItem?       @relation("UnitLink", fields: [parentItemId], references: [id], onDelete: SetNull)
  childItems     MenuItem[]      @relation("UnitLink")
  staffMenuItems StaffMenuItem[]
}

model Table {
  id           String   @id @default(cuid())
  number       String   @unique
  status       String   @default("FREE") // FREE, OCCUPIED, WAITING_PAYMENT
  mergedWithId String?
  createdAt    DateTime @default(now())
  pendingSync  Boolean  @default(true)

  orders Order[]
}

model Order {
  id          String   @id @default(cuid())
  tableId     String
  waiterId    String
  status      String   @default("OPEN") // OPEN, PAID, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pendingSync Boolean  @default(true)  // true = not yet synced to cloud
  syncedAt    DateTime?               // when it was last synced

  table      Table       @relation(fields: [tableId], references: [id])
  waiter     User        @relation(fields: [waiterId], references: [id])
  orderItems OrderItem[]
  payment    Payment?

  @@index([status])
  @@index([tableId])
  @@index([pendingSync])
  @@index([createdAt])
  @@index([tableId, status])
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  menuItemId   String
  quantity     Int
  notes        String?
  status       String    @default("PENDING") // PENDING, PRINTED, CANCELLED
  printedAt    DateTime?
  createdAt    DateTime  @default(now())
  pendingSync  Boolean   @default(true)

  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem       @relation(fields: [menuItemId], references: [id])
  cancellation Cancellation?

  @@index([orderId])
  @@index([pendingSync])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  cashierId       String
  amount          Float
  method          String   // Cash, Telebirr, CBE Birr, Bank Transfer
  discount        Float    @default(0)
  discountType    String   @default("fixed") // fixed, percentage
  isComplimentary Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  pendingSync     Boolean  @default(true)

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashier User  @relation(fields: [cashierId], references: [id])

  @@index([pendingSync])
  @@index([createdAt])
}

model Cancellation {
  id          String   @id @default(cuid())
  orderItemId String   @unique
  managerId   String
  reason      String
  createdAt   DateTime @default(now())
  pendingSync Boolean  @default(true)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  manager   User      @relation(fields: [managerId], references: [id])
}

model ShiftLog {
  id        String    @id @default(cuid())
  userId    String
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Ingredient {
  id           String   @id @default(cuid())
  name         String
  unit         String   // grams, kg, pieces, liters, ml
  quantity     Float    @default(0)
  costPerUnit  Float    @default(0) // Bought / cost price per unit
  minThreshold Float    @default(0)
  createdAt    DateTime @default(now())

  recipes      Recipe[]
}

model Recipe {
  id           String     @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Float      // amount of ingredient needed per 1 serving

  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
}

model InventoryLog {
  id          String   @id @default(cuid())
  itemName    String
  type        String   // STORE, BAR, INGREDIENT
  action      String   // ADD, TRANSFER, INITIAL, SET
  quantity    Float
  prevQty     Float
  newQty      Float
  userName    String
  createdAt   DateTime @default(now())
  pendingSync Boolean  @default(true)
}

model StaffMember {
  id          String      @id @default(cuid())
  name        String
  role        String      // e.g. Waiter, Chef, Cashier, Cleaner
  shift       String      @default("Morning") // Morning, Afternoon, Night
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  pendingSync Boolean     @default(true)

  meals     StaffMeal[]
}

model StaffMenuItem {
  id               String          @id @default(cuid())
  name             String
  mealType         String          // BREAKFAST, LUNCH, DINNER
  linkedMenuItemId String?
  createdAt        DateTime        @default(now())
  pendingSync      Boolean         @default(true)

  linkedMenuItem   MenuItem?       @relation(fields: [linkedMenuItemId], references: [id], onDelete: SetNull)
  mealItems        StaffMealItem[]
  recipes          StaffRecipe[]
}

// Raw-ingredient stock for the staff kitchen — kept separate from the main
// Ingredient/Recipe inventory. Admin-only. Auto-deducted when a staff meal is logged.
model StaffIngredient {
  id           String        @id @default(cuid())
  name         String
  unit         String        // grams, kg, pieces, liters, ml
  quantity     Float         @default(0)
  minThreshold Float         @default(0)
  createdAt    DateTime      @default(now())
  pendingSync  Boolean       @default(true)

  recipes      StaffRecipe[]
}

model StaffRecipe {
  id                String          @id @default(cuid())
  staffMenuItemId   String
  staffIngredientId String
  quantity          Float           // amount of ingredient consumed per 1 serving
  pendingSync       Boolean         @default(true)

  staffMenuItem     StaffMenuItem   @relation(fields: [staffMenuItemId], references: [id], onDelete: Cascade)
  staffIngredient   StaffIngredient @relation(fields: [staffIngredientId], references: [id], onDelete: Cascade)

  @@unique([staffMenuItemId, staffIngredientId])
}

model StaffMeal {
  id            String          @id @default(cuid())
  staffMemberId String
  mealType      String          // BREAKFAST, LUNCH, DINNER
  servedAt      DateTime        @default(now())
  createdAt     DateTime        @default(now())
  pendingSync   Boolean         @default(true)

  staffMember   StaffMember     @relation(fields: [staffMemberId], references: [id])
  items         StaffMealItem[]
}

model StaffMealItem {
  id              String        @id @default(cuid())
  staffMealId     String
  staffMenuItemId String
  quantity        Int           @default(1)
  pendingSync     Boolean       @default(true)

  staffMeal       StaffMeal     @relation(fields: [staffMealId], references: [id], onDelete: Cascade)
  staffMenuItem   StaffMenuItem @relation(fields: [staffMenuItemId], references: [id])
}

model DevAuditLog {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  developerUsername String
  action            String   // CREATE, UPDATE, DELETE, SQL_QUERY, SEED, RESET, SYNC
  targetTable       String
  recordId          String?
  previousState     String?  // JSON string
  newState          String?  // JSON string
  reason            String?
  ipAddress         String?

  @@index([targetTable])
  @@index([timestamp])
  @@index([action])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?  // SUCCESS, INVALID_PASSWORD, ACCOUNT_INACTIVE, USER_NOT_FOUND, RATE_LIMITED, INVALID_INPUT
  portal    String   @default("POS") // POS, ABEBE_CONSOLE
  createdAt DateTime @default(now())

  @@index([username])
  @@index([createdAt])
  @@index([success])
}

model LoginHistory {
  id        String    @id @default(cuid())
  userId    String?
  username  String
  fullName  String?
  role      String?
  ipAddress String?
  userAgent String?
  portal    String    @default("POS") // POS, ABEBE_CONSOLE
  status    String    @default("ACTIVE") // ACTIVE, LOGGED_OUT, EXPIRED
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([username])
  @@index([userId])
  @@index([loginAt])
  @@index([status])
}

model WasteLog {
  id          String   @id @default(cuid())
  itemName    String
  itemType    String   // INGREDIENT, MENU_ITEM
  itemId      String?
  location    String?  // STORE, BAR
  quantity    Float
  unit        String?
  costPerUnit Float    @default(0)
  totalCost   Float    @default(0)
  reason      String
  notes       String?
  loggedBy    String
  createdAt   DateTime @default(now())
  pendingSync Boolean  @default(true)

  @@index([itemName])
  @@index([itemType])
  @@index([createdAt])
  @@index([pendingSync])
}

model AbebeCredential {
  id           String   @id @default("master_root")
  username     String   @default("ROOT")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}



